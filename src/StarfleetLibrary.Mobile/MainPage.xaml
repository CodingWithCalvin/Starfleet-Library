<Page x:Class="StarfleetLibrary.Mobile.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:utu="using:Uno.Toolkit.UI" Background="#F4F6F9" RequestedTheme="Light">
  <Page.Resources>
    <DataTemplate x:Key="ShelfCard">
      <Grid Padding="0,10" ColumnSpacing="16" AutomationProperties.Name="{Binding AccessibleName}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="76" Height="112" Background="#DDE5EB" CornerRadius="6"><Image Source="{Binding Cover}" Stretch="Uniform"/></Border>
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" Foreground="#147077" FontWeight="SemiBold" FontSize="11"/>
          <TextBlock Text="{Binding Title}" Foreground="#17243B" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3"/>
          <TextBlock Text="{Binding Authors}" Foreground="#596A7C" FontSize="13" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Format}" Foreground="#526376" FontSize="12"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ShelfCover">
      <Grid Width="132" Height="202" Background="#DDE5EB" AutomationProperties.Name="{Binding AccessibleName}">
        <TextBlock Text="{Binding Title}" Margin="12" TextWrapping="Wrap" Foreground="#526376" VerticalAlignment="Center"/>
        <Image Source="{Binding Cover}" Stretch="Uniform"/>
        <Canvas Width="94" Height="94" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
          <Canvas.Clip><RectangleGeometry Rect="0,0,94,94"/></Canvas.Clip>
          <Border Canvas.Left="4" Canvas.Top="18" Width="128" Height="24" Background="{Binding Ribbon}" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform>
            <TextBlock Text="{Binding FormatCaps}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Canvas>
      </Grid>
    </DataTemplate>
  </Page.Resources>
  <Grid MaxWidth="840" utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#101D32" Padding="20,22,20,18">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="5"><TextBlock Text="STARFLEET LIBRARY" FontSize="11" CharacterSpacing="180" Foreground="#77CDD0"/><TextBlock x:Name="Heading" Text="Your collection" Foreground="White" FontSize="28" FontWeight="SemiBold"/></StackPanel>
        <Button Grid.Column="1" Content="+ Add" Click="AddClicked" Background="#147077" Foreground="White" BorderThickness="0" VerticalAlignment="Center" MinHeight="44" AutomationProperties.Name="Add edition"/>
      </Grid>
    </Border>
    <Button x:Name="SyncStatus" Grid.Row="1" Content="Connecting your library…" Click="SyncClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="#E5F1F0" Foreground="#165E63" BorderThickness="0" Padding="20,10" MinHeight="44"/>
    <Grid x:Name="Body" Grid.Row="2" Margin="20,12,20,0"/>
    <Grid Grid.Row="3" Background="White" Padding="12,8,12,20" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="CollectionNav" Content="▤  Collection" Click="CollectionClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="48" BorderThickness="0"/>
      <Button x:Name="WishlistNav" Grid.Column="1" Content="♡  Wishlist" Click="WishlistClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="48" BorderThickness="0"/>
    </Grid>
  </Grid>
</Page>
