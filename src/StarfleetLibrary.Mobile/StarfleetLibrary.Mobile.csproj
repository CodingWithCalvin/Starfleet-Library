<Project Sdk="Uno.Sdk/6.7.45">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm</TargetFrameworks>
    <TargetFrameworks Condition="'$(EnableIos)' == 'true'">net10.0-browserwasm;net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Starfleet Library</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.calvin.starfleetlibrary.mobile</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>StarfleetLibrary.Mobile</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Your Collection and Wishlist, wherever you explore.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarfleetLibrary.Core\StarfleetLibrary.Core.csproj" />
    <ProjectReference Include="..\StarfleetLibrary.Sync\StarfleetLibrary.Sync.csproj" />
    <Compile Include="..\StarfleetLibrary.Uno\Services\ISBNLookup.cs" Link="ISBNLookup.cs" />
  </ItemGroup>
</Project>
