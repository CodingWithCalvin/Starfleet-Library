<Project Sdk="Uno.Sdk/6.7.45">
  <PropertyGroup>
    <TargetFrameworks>net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(MobileWindowsPreview)' == 'true'">net10.0-windows10.0.26100</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Starfleet Library</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.calvin.starfleetlibrary.mobile</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>StarfleetLibrary.Mobile</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Your Collection and Wishlist, wherever you explore.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Toolkit;
    </UnoFeatures>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <!-- Optional IL stripping stalled on the hosted Mac; retain IL and keep normal native compilation. -->
    <EnableAssemblyILStripping>false</EnableAssemblyILStripping>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MobileWindowsPreview)' == 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarfleetLibrary.Core\StarfleetLibrary.Core.csproj" />
    <ProjectReference Include="..\StarfleetLibrary.Sync\StarfleetLibrary.Sync.csproj" />
    <Compile Include="..\StarfleetLibrary.Uno\Services\ISBNLookup.cs" Link="ISBNLookup.cs" />
  </ItemGroup>
</Project>
