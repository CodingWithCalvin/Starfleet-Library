<Page x:Class="StarfleetLibrary.Uno.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 RequestedTheme="Light" Background="#F4F6F9">
 <Page.Resources>
  <SolidColorBrush x:Key="Ink" Color="#17243B" />
  <SolidColorBrush x:Key="Muted" Color="#617087" />
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#147D83" />
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="HorizontalAlignment" Value="Stretch" />
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="Foreground" Value="#E7EDF7" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Padding" Value="14,12" />
   <Setter Property="CornerRadius" Value="8" />
  </Style>
  <DataTemplate x:Key="CoverTemplate">
   <Grid Width="156" Height="232" Background="#E4E9EF" CornerRadius="5"
     AutomationProperties.Name="{Binding AccessibleName}" ToolTipService.ToolTip="{Binding Title}">
    <FontIcon Glyph="&#xE8F1;" FontSize="34" Foreground="#8B99AA" />
    <Image Loaded="CoverLoaded" DataContextChanged="CoverContextChanged" Stretch="Uniform" Source="{Binding Cover}" />
    <Canvas Width="94" Height="94" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
     <Canvas.Clip><RectangleGeometry Rect="0,0,94,94" /></Canvas.Clip>
     <Border Canvas.Left="4" Canvas.Top="18" Width="128" Height="24"
       Background="{Binding FormatRibbonBackground}" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><RotateTransform Angle="45" /></Border.RenderTransform>
      <TextBlock Text="{Binding FormatRibbon}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"
        HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
    </Canvas>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="CardTemplate">
   <Grid Padding="16" ColumnSpacing="20" Background="White" CornerRadius="10" MinHeight="148" AutomationProperties.Name="{Binding AccessibleName}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Width="76" Height="112" Background="#E4E9EF" CornerRadius="3">
     <FontIcon Glyph="&#xE8F1;" Foreground="#8B99AA" />
     <Image Loaded="CoverLoaded" DataContextChanged="CoverContextChanged" Stretch="Uniform" Source="{Binding Cover}" />
    </Grid>
    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
     <TextBlock Text="{Binding Label}" Foreground="#147D83" FontWeight="SemiBold" FontSize="11" CharacterSpacing="100" />
     <TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis" />
     <TextBlock Text="{Binding Authors}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
     <TextBlock Text="{Binding EditionLine}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center" Width="94">
     <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="12" />
     <ProgressBar Value="{Binding Progress}" Maximum="100" Foreground="#147D83" Height="3" />
    </StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="TableTemplate">
   <Grid Height="58" ColumnSpacing="16" Padding="16,0" BorderBrush="#E9EDF2" BorderThickness="0,0,0,1" AutomationProperties.Name="{Binding AccessibleName}">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="80"/><ColumnDefinition Width="65"/>
     <ColumnDefinition Width="90"/><ColumnDefinition Width="50"/><ColumnDefinition Width="90"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource Ink}" />
    <TextBlock Grid.Column="1" Text="{Binding Authors}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
    <TextBlock Grid.Column="2" Text="{Binding Series}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
    <TextBlock Grid.Column="3" Text="{Binding Kind}" VerticalAlignment="Center" FontSize="11" Foreground="#147D83" />
    <TextBlock Grid.Column="4" Text="{Binding Format}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
    <TextBlock Grid.Column="5" Text="{Binding Year}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
    <TextBlock Grid.Column="6" Text="{Binding Status}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
   </Grid>
  </DataTemplate>
 </Page.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Background="#101D32" Padding="16,28,16,18" RowSpacing="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0,0,16">
    <Viewbox Width="27" Height="40"><Path Fill="#77D9CC" Data="M 20,0 L 40,58 L 21,41 L 0,58 Z M 20,17 L 17,30 L 25,30 Z" /></Viewbox>
    <StackPanel x:Name="BrandWords" VerticalAlignment="Center" Spacing="2">
     <TextBlock Text="STARFLEET" Foreground="White" FontWeight="SemiBold" FontSize="14" CharacterSpacing="160" />
     <TextBlock Text="Your personal library" Foreground="#93A8C4" FontSize="11" />
    </StackPanel>
   </StackPanel>
   <StackPanel x:Name="NavItems" Grid.Row="1" Spacing="6" />
   <StackPanel Grid.Row="2" Spacing="20">
    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsClicked" AutomationProperties.Name="Settings">
     <StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE713;" FontSize="18"/><TextBlock x:Name="SettingsWords" Text="Settings" /></StackPanel>
    </Button>
    <TextBlock x:Name="SidebarFooter" Text="A universe of stories.&#xA;One place to keep them." Foreground="#93A8C4" FontSize="11" LineHeight="18" Margin="14,0,0,0" />
   </StackPanel>
  </Grid>
  <Grid x:Name="Workspace" Grid.Column="1" Margin="32,28,32,24" RowSpacing="18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="5">
     <TextBlock Text="THE CAPTAIN’S SHELF" FontSize="10" FontWeight="SemiBold" CharacterSpacing="180" Foreground="#147D83" />
     <TextBlock x:Name="PageTitle" Text="Your collection" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
     <TextBlock x:Name="PageSubtitle" Text="Every edition. Every adventure." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
    </StackPanel>
    <Button x:Name="AddBookButton" Grid.Column="1" Content="+  Add book" Style="{StaticResource AccentButtonStyle}" Padding="18,11" CornerRadius="8" VerticalAlignment="Center" Click="AddClicked" AutomationProperties.AutomationId="AddBook" />
   </Grid>
   <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" />
   <Grid x:Name="Body" Grid.Row="2" />
  </Grid>
 </Grid>
</Page>
