<Application x:Class="StarfleetLibrary.Uno.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <Color x:Key="SystemAccentColor">#147D83</Color>
      <Color x:Key="SystemAccentColorDark1">#147D83</Color>
      <Color x:Key="SystemAccentColorDark2">#10696E</Color>
      <Color x:Key="SystemAccentColorLight1">#3E9B9F</Color>
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#147D83" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#218B90" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#10696E" />

    </ResourceDictionary>
  </Application.Resources>

</Application>
